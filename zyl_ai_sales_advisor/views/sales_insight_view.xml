<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         Sales Insight — List
    ════════════════════════════════════════════════════════════════ -->
    <record id="view_sales_insight_list" model="ir.ui.view">
        <field name="name">zyl.sales.insight.list</field>
        <field name="model">zyl.sales.insight</field>
        <field name="arch" type="xml">
            <list string="Sales Insights"
                  decoration-danger="priority=='2'"
                  decoration-warning="priority=='1'">
                <field name="priority" widget="priority"/>
                <field name="title"/>
                <field name="insight_type" widget="badge"/>
                <field name="period_label" string="Period"/>
                <field name="generated_by" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <!-- Sales Insight — Form -->
    <record id="view_sales_insight_form" model="ir.ui.view">
        <field name="name">zyl.sales.insight.form</field>
        <field name="model">zyl.sales.insight</field>
        <field name="arch" type="xml">
            <form string="Sales Insight">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-success"
                            invisible="state == 'published'"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="priority" string=""/>
                        <field name="priority" widget="priority" class="me-2"/>
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="insight_type"/>
                            <field name="period_label"/>
                            <field name="generated_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Analysis">
                            <field name="summary" placeholder="One-line summary..."/>
                            <separator string="Full Insight"/>
                            <field name="content" widget="html" readonly="1"/>
                        </page>
                        <page string="Raw Data" groups="zyl_ai_sales_advisor.group_sales_ai_manager">
                            <field name="raw_data" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_sales_insight_search" model="ir.ui.view">
        <field name="name">zyl.sales.insight.search</field>
        <field name="model">zyl.sales.insight</field>
        <field name="arch" type="xml">
            <search string="Search Insights">
                <field name="title"/>
                <field name="insight_type"/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="high_priority" string="High Priority" domain="[('priority','in',['1','2'])]"/>
                <filter name="auto" string="Auto-Generated" domain="[('generated_by','=','auto')]"/>
                <filter name="manual" string="Manual" domain="[('generated_by','=','manual')]"/>
                <separator/>
                <group>
                    <filter name="group_type" string="Type" domain="[]" context="{'group_by':'insight_type'}"/>
                    <filter name="group_month" string="Month" domain="[]" context="{'group_by':'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sales_insights" model="ir.actions.act_window">
        <field name="name">Sales Insights</field>
        <field name="res_model">zyl.sales.insight</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sales_insight_search"/>
        <field name="context">{'search_default_published': 1}</field>
    </record>

</odoo>
