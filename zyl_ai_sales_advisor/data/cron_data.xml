<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Weekly insight generation cron -->
    <record id="ir_cron_generate_insights" model="ir.cron">
        <field name="name">AI Sales Advisor: Generate Weekly Insights</field>
        <field name="model_id" ref="model_zyl_sales_insight"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_weekly_insights()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Monthly cleanup of stale chat sessions -->
    <record id="ir_cron_cleanup_sessions" model="ir.cron">
        <field name="name">AI Sales Advisor: Archive Old Chat Sessions</field>
        <field name="model_id" ref="model_zyl_ai_chat_session"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_old_sessions(days=90)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
